# Optional absolute JSON state path for the MCP server.
# Default is data/claims/claims.json; demo uses a temporary copy automatically.
# AIPR_STATE_PATH=/absolute/path/to/claims.json

# Optional Hugging Face cache for the real retrieval model.
# HF_HOME=/absolute/path/to/model-cache

# No LLM provider is configured by TV3. API integration belongs to TV2.
# The application reads exported environment variables; it does not auto-load this file.
